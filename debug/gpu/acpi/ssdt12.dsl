                /* 0708 */  0xFF, 0x1F                                       // ..
            })
            Method (WM01, 3, NotSerialized)
            {
                Local0 = (Arg1 & 0xFF)
                Name (TBUF, Buffer (0x0100)
                {
                     0x00                                             // .
                })
                If ((Local0 == One))
                {
                    TBUF = Arg2
                    Local1 = SizeOf (Arg2)
                    If ((ToString (TBUF, Local1) == "SelectUSBBootFirst"))
                    {
                        HSMI (One, 0x81)
                        Return ("SET USB BOOT FIRST Success!")
                    }
                    ElseIf ((ToString (TBUF, Local1) == "SelectPxeBootFirst"))
                    {
                        HSMI (0x02, 0x81)
                        Return ("SET PXE BOOT FIRST Success!")
                    }
                    ElseIf ((ToString (TBUF, Local1) == "SelectWINBootFirst"))
                    {
                        HSMI (0x03, 0x81)
                        Return ("SET HDD BOOT FIRST Success!")
                    }
                    Else
                    {
                        Return ("Undefined Boot device!")
                    }
                }
                ElseIf ((Local0 == 0x02))
                {
                    HSMI (0x04, 0x81)
                    Return ("SET BIOS LOAD DEFAULT SUCCESS!")
                }
                ElseIf ((Local0 == 0x03))
                {
                    Local1 = ToInteger (Arg2)
                    HSMI (Local1, 0x82)
                    If (CondRefOf (\_SB.PC00.LPCB.H_EC.ECD2))
                    {
                        \_SB.PC00.LPCB.H_EC.ECD2 (0xDD, Local1)
                    }

                    Return ("CONFIG S5 WAKE SUCCESS!")
                }
                ElseIf ((Local0 == 0x04))
                {
                    CIDX = 0xA0
                    CDTA = 0x55
                    HSMI (0x05, 0x81)
                    Return ("Enable PXE BOOT Success!")
                }
                ElseIf ((Local0 == 0x05))
                {
                    HSMI (Zero, 0x87)
                    Return ("Load Default Secure Boot Key Success!")
                }
                ElseIf ((Local0 == 0x06))
                {
                    HSMI (One, 0x87)
                    Return ("Clear Secure Boot Key Success!")
                }
                ElseIf ((Local0 == 0x07))
                {
                    HSMI (One, 0x88)
                    Return ("Set OOB Test mode Success!")
                }
                ElseIf ((Local0 == 0x08))
                {
                    If ((CondRefOf (\_SB.PC00.LPCB.H_EC.ECWT) && CondRefOf (\_SB.PC00.LPCB.H_EC.NTDP)))
                    {
                        HSMI (Zero, 0x88)
                        \_SB.PC00.LPCB.H_EC.ECWT (One, RefOf (\_SB.PC00.LPCB.H_EC.STNM))
                        Sleep (0x05)
                        \_SB.PC00.LPCB.H_EC.NTDP (\_SB.PC00.LPCB.H_EC.ECRD (RefOf (\_SB.PC00.LPCB.H_EC.STNM)))
                    }

                    Return ("Clear OOB Test mode Success!")
                }
                ElseIf ((Local0 == 0x09))
                {
                    If ((CondRefOf (\_SB.PC00.LPCB.H_EC.ECWT) && CondRefOf (\_SB.PC00.LPCB.H_EC.NTDP)))
                    {
                        Local1 = ToInteger (Arg2)
                        \_SB.PC00.LPCB.H_EC.ECWT (Local1, RefOf (\_SB.PC00.LPCB.H_EC.STNM))
                        Sleep (0x05)
                        \_SB.PC00.LPCB.H_EC.NTDP (\_SB.PC00.LPCB.H_EC.ECRD (RefOf (\_SB.PC00.LPCB.H_EC.STNM)))
                    }

                    Return ("Set performance mode Success!")
                }
                ElseIf ((Local0 == 0x0A))
                {
                    WICC = ToInteger (Arg2)
                    HSMI (0x02, 0x88)
                    Return ("Set country code Success!")
                }
                ElseIf ((Local0 == 0x0B))
                {
                    SPCC = ToInteger (Arg2)
                    HSMI (0x03, 0x88)
                    Return ("Set shipping country code Success!")
                }
                Else
                {
                    Return ("Undefined Command!")
                }
            }

            Method (WMAB, 3, NotSerialized)
            {
                If ((Arg1 == One))
                {
                    CIDX = 0x61
                    CDTA = 0xFF
                    Local1 = ToInteger (Arg2)
                    HSMI (Local1, 0x82)
                    Sleep (0x05)
                    CIDX = 0x61
                    Local2 = CDTA /* \_SB_.HQWI.CDTA */
                    If ((Local2 == Zero))
                    {
                        Return ("CONFIG S5 RTC WAKE SUCCESS!")
                    }

                    Return ("CONFIG S5 RTC WAKE FAIL!")
                }

                If ((Arg1 == 0x02))
                {
                    Return ("0x00013100")
                }

                Return ("Unsupport command.")
            }
        }
    }
}

